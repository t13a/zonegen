.DELETE_ON_ERROR:
MAKEFLAGS += --no-builtin-rules --no-builtin-variables --warn-undefined-variables
SHELL := bash
.SHELLFLAGS := -euo pipefail -O nullglob -c
# The index is committed, so the order of its entries must not depend on the locale.
export LC_ALL := C

JSONNET = jsonnet
NAMED_CHECKZONE = named-checkzone
REGISTRY_DIR = registry
ZONEFILES_DIR = zonefiles
CODE = render(registry)

$(foreach v,REGISTRY_DIR ZONEFILES_DIR,$(if $(strip $($(v))),,$(error $(v) is empty)))

INDEX := $(REGISTRY_DIR)/index.libsonnet
TMP_DIR := $(ZONEFILES_DIR)/.tmp
# The servers import zonegen.libsonnet, which lives next to this Makefile.
JPATH := -J $(CURDIR)

.PHONY: gen print $(INDEX)
gen: $(INDEX)
	rm -rf $(TMP_DIR)
	$(JSONNET) $(JPATH) -S -c -m $(TMP_DIR) --tla-code-file registry=$(INDEX) main.jsonnet > /dev/null
	for f in $(TMP_DIR)/*/*.zone; do \
	  if ! cmp -s $$f $(ZONEFILES_DIR)/$${f#$(TMP_DIR)/}; then \
	    o=$$(basename $$f .zone); $(NAMED_CHECKZONE) -q $$o $$f || { $(NAMED_CHECKZONE) $$o $$f; exit 1; }; \
	  fi; done
	rm -rf $(ZONEFILES_DIR)/*
	mv $(TMP_DIR)/* $(ZONEFILES_DIR)/
	rmdir $(TMP_DIR)

# CODE reaches jsonnet through the environment, so neither make nor the shell changes it.
unexport CODE
print: override export CODE := $(value CODE)
print: $(INDEX)
	@$(JSONNET) $(JPATH) --ext-code-file registry=$(INDEX) --ext-code-file render=main.jsonnet \
	  -e "local registry = std.extVar('registry'), render = std.extVar('render'), zonegen = import 'zonegen.libsonnet'; $$CODE"

# A layer is a JSON or Jsonnet file, and the layers of a directory are merged in the order of their names.
layers = $$(for f in $(1)/*; do case $$f in *.json|*.libsonnet) echo -n "import '$${f\#$(REGISTRY_DIR)/}', ";; esac; done)

$(INDEX):
	@{ echo '// Generated by `make` from the directories next to it. Do not edit.'; \
	  echo '{'; \
	  for d in $(REGISTRY_DIR)/*/; do d=$$(basename $$d); case $$d in \
	    zones) echo '  zones:: {'; \
	      for z in $(REGISTRY_DIR)/zones/*/; do z=$$(basename $$z); \
	        echo "    '$$z': [$(call layers,$(REGISTRY_DIR)/zones/$$z)],"; done; \
	      echo '  },';; \
	    servers) echo '  servers: {'; \
	      for f in $(REGISTRY_DIR)/servers/*.libsonnet; do n=$$(basename $$f .libsonnet); \
	        echo "    '$$n': import 'servers/$$n.libsonnet',"; done; \
	      echo '  },';; \
	    *) echo "  $$d:: {"; \
	      for f in $(REGISTRY_DIR)/$$d/*.json $(REGISTRY_DIR)/$$d/*.libsonnet; do n=$$(basename $$f); \
	        echo "    '$${n%.*}': import '$$d/$$n',"; done; \
	      echo '  },';; \
	  esac; done; \
	  echo '}'; } > $@
