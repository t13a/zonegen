local zonegen = import 'zonegen.libsonnet';

// RFC 1035 5.2 wants the SOA first. NS follows by convention.
local typeOrder(t) = if t == 'soa' then '0' else if t == 'ns' then '1' else '2' + t;
// Pads numeric labels, so that the records of a reverse zone come in the order of their addresses.
local nameOrder(n) =
  if n == '@' then ''
  else if std.all([std.member('0123456789', c) for c in std.stringChars(n)]) then std.repeat('0', 3 - std.length(n)) + n
  else n;

local zonefile(origin, zone) =
  local values(v) = if std.isString(v) then [v] else [x for x in std.objectFields(v) if v[x] == true];
  local records = std.sort([
    { name: n, type: t, data: d }
    for n in std.objectFields(zone) if !std.startsWith(n, '$') && zone[n] != null
    for t in std.objectFields(zone[n]) if zone[n][t] != null
    for d in values(zone[n][t])
  ], function(r) [nameOrder(r.name), typeOrder(r.type)]);
  '; Generated by zonegen. Do not edit.\n'
  + '$ORIGIN ' + origin + '.\n'
  + (if std.objectHas(zone, '$ttl') && zone['$ttl'] != null then '$TTL ' + zone['$ttl'] + '\n' else '')
  + std.join('', [r.name + '\t' + std.asciiUpper(r.type) + '\t' + r.data + '\n' for r in records]);

local check(name, server) =
  local unknown = std.setDiff(std.objectFields(server), ['zones']);
  if std.length(unknown) > 0 then error name + ': unknown field ' + std.join(', ', unknown) else true;

function(registry)
  local defaults = if std.objectHasAll(registry, 'defaults') then registry.defaults else [];
  local servers = registry.servers;
  {
    [s + '/' + o + '.zone']: zonefile(o, zonegen.merge(defaults + servers[s].zones[o]))
    for s in std.objectFields(servers) if check(s, servers[s])
    for o in std.objectFields(servers[s].zones) if servers[s].zones[o] != null
  }
